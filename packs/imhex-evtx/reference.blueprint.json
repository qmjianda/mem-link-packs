{"format":"memlink-blueprint/3","packs":[{"id":"p1","name":"MS Windows Vista Event Log","source":"/// <reference path=\"../../../types/memlink-bp.d.ts\" />\n\n// 由 store/scripts/port-imhex.mjs 自动生成，请勿手工编辑。\n// 修改：2026-11-21 由上游 .hexpat 静态移植为 mem-link pack（非上游原文件）。\n// 上游：https://github.com/WerWolv/ImHex-Patterns/blob/master/evtx.hexpat\n// 许可：GPL-2.0-only（ImHex-Patterns）；生成物按同一许可分发。\n// 覆盖：complete\nconst Header = struct(\"Header\", [\n  str(\"signature\", { size: 8 }),\n  u64(\"first_chunk_number\", {  }),\n  u64(\"last_chunk_number\", {  }),\n  u64(\"next_record_identifier\", {  }),\n  u32(\"header_size\", {  }),\n  u16(\"minor_format_version\", {  }),\n  u16(\"major_format_version\", {  }),\n  u16(\"header_block_size\", {  }),\n  u16(\"number_of_chunks\", {  }),\n  bytes(\"unknown\", { size: 76 }),\n  u32(\"file_Flag\", {  }),\n  u32(\"checkSum\", {  }),\n  bytes(\"unknown2\", { size: 3968 }),\n]);\n\nconst BinaryXML = struct(\"BinaryXML\", [\n  u8(\"fragment_header_token\", {  }),\n  u8(\"major_version\", {  }),\n  u8(\"minor_version\", {  }),\n  u8(\"flags\", {  }),\n]);\n\nconst Event_Record = struct(\"Event_Record\", [\n  u32(\"signature\", {  }),\n  u32(\"size\", {  }),\n  u64(\"event_record_identifier\", {  }),\n  u64(\"written_data_amd_time\", {  }),\n  record(\"binaryxml\", BinaryXML),\n]);\n\nconst Chunk = struct(\"Chunk\", [\n  str(\"signature\", { size: 8 }),\n  u64(\"first_event_record_number\", {  }),\n  u64(\"last_event_record_number\", {  }),\n  u64(\"first_event_record_identifier\", {  }),\n  u64(\"last_event_record_identifier\", {  }),\n  u32(\"header_size\", {  }),\n  u32(\"last_event_record_data_offset\", {  }),\n  u32(\"free_space_offset\", {  }),\n  u32(\"event_records_checksum\", {  }),\n  bytes(\"unknown\", { size: 64 }),\n  u32(\"unknown2\", {  }),\n  u32(\"checksum\", {  }),\n  bytes(\"common_string_offset_array\", { size: 256 }),\n  bytes(\"templatePtr\", { size: 128 }),\n  record(\"event_record\", Event_Record),\n]);\n\nconst Evtx = struct(\"Evtx\", [\n  record(\"header\", Header),\n  record(\"chunk\", Chunk),\n]);\n\nexport default definePack({\n  name: \"MS Windows Vista Event Log\",\n  endian: \"little\",\n  pointerSize: 8,\n  types: [Header, BinaryXML, Event_Record, Chunk, Evtx],\n  nodes: {\n    \"entry\": structNode(Evtx, { label: \"Evtx（入口）\" }),\n    \"Header\": structNode(Header, { label: \"Header\" }),\n    \"BinaryXML\": structNode(BinaryXML, { label: \"BinaryXML\" }),\n    \"Event_Record\": structNode(Event_Record, { label: \"Event_Record\" }),\n    \"Chunk\": structNode(Chunk, { label: \"Chunk\" }),\n  },\n});\n\n","enabled":true,"store":{"url":"https://cdn.jsdelivr.net/gh/qmjianda/mem-link-packs@main/index.json","packId":"imhex-evtx","version":"1.0.0","path":"packs/imhex-evtx/pack.bp.ts","reference":{"path":"packs/imhex-evtx/reference.blueprint.json"}}}],"nodes":[{"id":"n1","packId":"","nodeId":"note","x":0,"y":0,"params":{"text":"ImHex · Evtx · 参考蓝图\nMS Windows Vista Event Log\n这是从 Pack 商店打开的临时示例，不会覆盖你的工作图。\n1. 选中 File 节点，可以重新载入真实的 ImHex · Evtx 文件；当前是 4096 B 的零填充示例。\n2. 解析节点的数据源和地址已经接好；选中节点后，右侧检查器会显示字段和「帮助」。\n3. 本 pack 的 5 个解析节点都已经摆在画布上。\n注意：类型最长需要 4636 B，示例只覆盖前 4096 B；载入真实文件后更完整。\n许可：GPL-2.0-only · 来源：https://github.com/WerWolv/ImHex-Patterns/blob/master/evtx.hexpat","tone":"info","__w":"560","__h":"196"}},{"id":"n2","packId":"","nodeId":"file","x":0,"y":246,"params":{"name":"sample-imhex-evtx.bin"},"source":{"name":"sample-imhex-evtx.bin","base":"0x0","data":""}},{"id":"n3","packId":"p1","nodeId":"entry","x":640,"y":0,"params":{"address":"0x0"}},{"id":"n4","packId":"p1","nodeId":"Header","x":1020,"y":0,"params":{"address":"0x0"}},{"id":"n5","packId":"p1","nodeId":"BinaryXML","x":1400,"y":0,"params":{"address":"0x0"}},{"id":"n6","packId":"p1","nodeId":"Event_Record","x":640,"y":320,"params":{"address":"0x0"}},{"id":"n7","packId":"p1","nodeId":"Chunk","x":1020,"y":320,"params":{"address":"0x0"}}],"edges":[{"id":"e1","from":{"node":"n2","port":"buffer"},"to":{"node":"n3","port":"buff